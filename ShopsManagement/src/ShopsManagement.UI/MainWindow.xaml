<Window x:Class="ShopsManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopsManagement.UI.ViewModels"
        xmlns:views="clr-namespace:ShopsManagement.UI.Views"
        mc:Ignorable="d"
        Title="إدارة نشاطي التجاري" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BranchesViewModel}">
            <views:BranchesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DailyActivityViewModel}">
            <views:DailyActivityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
            <views:InvoicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TradersViewModel}">
            <views:TradersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}">
            <views:ZakatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/> <!-- Sidebar Navigation -->
            <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0F172A" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Application Logo / Header -->
                        <StackPanel Margin="0,10,0,20">
                            <TextBlock Text="إدارة نشاطي التجاري" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="نظام المبيعات والحسابات" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Separator Background="#1E293B" Margin="0,0,0,15"/>

                        <!-- Navigation Buttons -->
                        <RadioButton Content="لوحة التحكم" Style="{StaticResource NavButtonStyle}" 
                                     IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>

                        <RadioButton Content="النشاط اليومي والمبيعات" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="DailyActivity"/>

                        <RadioButton Content="الفروع التجارية" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Branches"/>

                        <RadioButton Content="فواتير البضاعة" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>

                        <RadioButton Content="التجار وحساباتهم" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Traders"/>

                        <RadioButton Content="الموظفون والرواتب" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Employees"/>

                        <RadioButton Content="دفتر الزكاة المستقل" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Zakat"/>

                        <RadioButton Content="التقارير والتصدير" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Reports"/>

                        <RadioButton Content="النسخ الاحتياطي" Style="{StaticResource NavButtonStyle}" 
                                     Command="{Binding NavigateCommand}" CommandParameter="Backup"/>

                        <RadioButton Content="الإعدادات" Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Watermark Footer -->
                <Border Grid.Row="1" Background="#020617" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Developed and Powered by :" Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                        <TextBlock Text="Mahboob Al-Emad" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="Segoe UI, Tahoma"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
