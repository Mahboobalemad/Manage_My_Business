<UserControl x:Class="ShopsManagement.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignHeight="720" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Section card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#E2E8F0"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="24,20"/>
            <Setter Property="Margin"           Value="0,0,0,16"/>
        </Style>

        <!-- Section title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Foreground"  Value="#0F172A"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Section subtitle -->
        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="#6B7280"/>
            <Setter Property="Margin"      Value="0,0,0,16"/>
        </Style>

        <!-- Option RadioButton card -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="FontFamily"       Value="Segoe UI, Tahoma"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Margin"           Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#F8FAFC"
                                BorderBrush="#CBD5E1" BorderThickness="1.5"
                                CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Grid.Column="0"
                                         Width="18" Height="18" Margin="0,0,12,0"
                                         Stroke="#CBD5E1" StrokeThickness="2"
                                         Fill="White" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg"  Property="Background"       Value="#EFF6FF"/>
                                <Setter TargetName="Bg"  Property="BorderBrush"      Value="#2563EB"/>
                                <Setter TargetName="Bg"  Property="BorderThickness"  Value="2"/>
                                <Setter TargetName="Dot" Property="Fill"             Value="#2563EB"/>
                                <Setter TargetName="Dot" Property="Stroke"           Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save button -->
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background"       Value="#2563EB"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontFamily"       Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Padding"          Value="32,10"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global font -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════════════════ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="24,16" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إعدادات التطبيق"
                               Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="تخصيص تفضيلات النسخ الاحتياطي والعملة والمظهر"
                               Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════ CONTENT ═════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,20,24,0">
            <StackPanel MaxWidth="820">

                <!-- ═══ 1: BACKUP FREQUENCY ═══════════════════════ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Header row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🗄️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="تفضيلات النسخ الاحتياطي التلقائي"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="يتم تشغيل النسخ الاحتياطي تلقائياً عند فتح التطبيق وإغلاقه وفق الجدول المحدد"
                                           Style="{StaticResource SectionSub}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column -->
                            <StackPanel Grid.Column="0">
                                <!-- Daily -->
                                <RadioButton GroupName="BackupFreq" Style="{StaticResource OptionCard}"
                                             IsChecked="{Binding IsDaily, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="📅 يومي" FontWeight="Bold" FontSize="13"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="نسخة احتياطية كل يوم عند فتح التطبيق"
                                                   FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Weekly -->
                                <RadioButton GroupName="BackupFreq" Style="{StaticResource OptionCard}"
                                             IsChecked="{Binding IsWeekly, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="📆 أسبوعي" FontWeight="Bold" FontSize="13"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="نسخة احتياطية مرة في الأسبوع"
                                                   FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Right column -->
                            <StackPanel Grid.Column="2">
                                <!-- Monthly - recommended -->
                                <RadioButton GroupName="BackupFreq" Style="{StaticResource OptionCard}"
                                             IsChecked="{Binding IsMonthly, Mode=TwoWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🗓️ شهري" FontWeight="Bold" FontSize="13"
                                                       Foreground="#1E293B"/>
                                            <TextBlock Text="نسخة احتياطية مرة كل شهر"
                                                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#DCFCE7"
                                                BorderBrush="#86EFAC" BorderThickness="1"
                                                CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                            <TextBlock Text="مُفضَّل" FontSize="10"
                                                       FontWeight="Bold" Foreground="#166534"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>

                                <!-- Yearly -->
                                <RadioButton GroupName="BackupFreq" Style="{StaticResource OptionCard}"
                                             IsChecked="{Binding IsYearly, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="📁 سنوي" FontWeight="Bold" FontSize="13"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="نسخة احتياطية مرة كل سنة"
                                                   FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ 2: CURRENCY ════════════════════════════════ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="💰" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="العملة المفضلة في التطبيق"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="تُستخدم هذه العملة لعرض الأرصدة والمبالغ في جميع أقسام التطبيق"
                                           Style="{StaticResource SectionSub}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- Info notice -->
                        <Border Background="#FEF9C3" BorderBrush="#FDE047"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Foreground="#713F12" TextWrapping="Wrap">
                                    <Run Text="تنبيه: "/>
                                    <Run Text="أسعار الصرف بين العملات غير متاحة حالياً وستُطوَّر في النسخ القادمة. تغيير العملة يؤثر فقط على وحدة العرض."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Rows="1">
                            <!-- YER -->
                            <RadioButton GroupName="CurrencyGroup" Style="{StaticResource OptionCard}"
                                         IsChecked="{Binding IsYer, Mode=TwoWay}"
                                         Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🇾🇪" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ريال يمني" FontWeight="Bold" FontSize="13"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="YER" FontSize="11" Foreground="#6B7280"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- SAR -->
                            <RadioButton GroupName="CurrencyGroup" Style="{StaticResource OptionCard}"
                                         IsChecked="{Binding IsSar, Mode=TwoWay}"
                                         Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🇸🇦" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ريال سعودي" FontWeight="Bold" FontSize="13"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="SAR" FontSize="11" Foreground="#6B7280"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- USD -->
                            <RadioButton GroupName="CurrencyGroup" Style="{StaticResource OptionCard}"
                                         IsChecked="{Binding IsUsd, Mode=TwoWay}"
                                         Margin="0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🇺🇸" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="دولار أمريكي" FontWeight="Bold" FontSize="13"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                    <TextBlock Text="USD" FontSize="11" Foreground="#6B7280"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ 3: DARK MODE ═══════════════════════════════ -->
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌙" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="الوضع الليلي (Dark Mode)"
                                           Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="تفعيل المظهر الداكن لحماية العيون في البيئات ذات الإضاءة المنخفضة"
                                       FontSize="11" Foreground="#6B7280" Margin="30,4,0,0"/>
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <TextBlock FontSize="11" Foreground="#0369A1">
                                    <Run Text="ℹ️ "/>
                                    <Run Text="الوضع الليلي الكامل سيكون متاحاً في النسخ القادمة — الإعداد يُحفظ حالياً"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Toggle switch -->
                        <ToggleButton Grid.Column="1" IsChecked="{Binding DarkMode, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="20,0,0,0"
                                      Width="60" Height="30" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Track" Background="#CBD5E1"
                                            CornerRadius="15" Width="60" Height="30">
                                        <Ellipse x:Name="Thumb" Width="22" Height="22"
                                                 Fill="White" HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#00000033" BlurRadius="4"
                                                                  ShadowDepth="1" Direction="270"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- ═══ SAVE BUTTON ════════════════════════════════ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,24">
                    <Button Content="💾  حفظ الإعدادات"
                            Style="{StaticResource SaveBtn}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════ STATUS BAR ═══════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" FontSize="13"/>
        </Border>

    </Grid>
</UserControl>
