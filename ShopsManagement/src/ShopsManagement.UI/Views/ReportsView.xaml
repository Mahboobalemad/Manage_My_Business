<UserControl x:Class="ShopsManagement.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ShopsManagement.UI.Converters"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ═══ Card Button Style (using Button not RadioButton to avoid binding issues) ═══ -->
        <Style x:Key="ReportCardBtn" TargetType="Button">
            <Setter Property="Background"        Value="#FFFFFF"/>
            <Setter Property="BorderBrush"       Value="#CBD5E1"/>
            <Setter Property="BorderThickness"   Value="1.5"/>
            <Setter Property="Padding"           Value="14,12"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CardBorder" Property="Background"  Value="#F0F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active card override (applied via Style + DataTrigger workaround: set via code-behind using Tag) -->
        <Style x:Key="ReportCardBtnActive" TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
            <Setter Property="Background"      Value="#EFF6FF"/>
            <Setter Property="BorderBrush"     Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ═══ Section label ═══ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#374151"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>

        <!-- ═══ Filter radio ═══ -->
        <Style x:Key="FilterRadio" TargetType="RadioButton">
            <Setter Property="FontFamily"  Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Foreground"  Value="#374151"/>
            <Setter Property="Margin"      Value="0,0,16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <!-- ═══ Print Button ═══ -->
        <Style x:Key="PrintBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="28,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global font -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="Height"     Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Report type cards -->
            <RowDefinition Height="*"/>     <!-- Filter panel -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════════════════ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="قسم إصدار التقارير"
                               Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="اختر نوع التقرير ثم حدد محددات الفلترة وأصدر التقرير"
                               Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════ REPORT TYPE CARDS ═══════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="ما هو التقرير الذي ترغب بإصداره؟"
                           FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <!-- Using UniformGrid of Buttons + Command to set SelectedReportKind -->
                <UniformGrid Columns="5">

                    <!-- 1: Daily Sales -->
                    <Button Command="{Binding SelectReportKindCommand}"
                            CommandParameter="DailySales"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportKind}" Value="DailySales">
                                        <Setter Property="Background"      Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush"     Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="1. النشاط اليومي" FontWeight="Bold" FontSize="12"
                                       Foreground="#1E293B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="والمبيعات" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- 2: Invoices -->
                    <Button Command="{Binding SelectReportKindCommand}"
                            CommandParameter="Invoices" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportKind}" Value="Invoices">
                                        <Setter Property="Background"      Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush"     Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="2. الفواتير" FontWeight="Bold" FontSize="12"
                                       Foreground="#1E293B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="المستلمة" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3: Trader -->
                    <Button Command="{Binding SelectReportKindCommand}"
                            CommandParameter="Trader" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportKind}" Value="Trader">
                                        <Setter Property="Background"      Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush"     Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🤝" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="3. كشف حساب" FontWeight="Bold" FontSize="12"
                                       Foreground="#1E293B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="التاجر" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4: Employee -->
                    <Button Command="{Binding SelectReportKindCommand}"
                            CommandParameter="Employee" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportKind}" Value="Employee">
                                        <Setter Property="Background"      Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush"     Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👷" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="4. كشف حساب" FontWeight="Bold" FontSize="12"
                                       Foreground="#1E293B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="الموظف" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5: Branch -->
                    <Button Command="{Binding SelectReportKindCommand}"
                            CommandParameter="Branch" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReportCardBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportKind}" Value="Branch">
                                        <Setter Property="Background"      Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush"     Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏪" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="5. كشف حساب" FontWeight="Bold" FontSize="12"
                                       Foreground="#1E293B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="الفرع" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ══════════════════ FILTER PANEL ════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,14,20,0">
            <StackPanel>

                <!-- === NO SELECTION PLACEHOLDER === -->
                <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0"
                        BorderThickness="1" Padding="40" Margin="0,0,0,14"
                        Visibility="{Binding ShowNoSelectionHint, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="اختر نوع التقرير من الأعلى لتظهر خيارات الفلترة"
                                   FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ 1: DAILY SALES FILTERS ═══════════════ -->
                <Border Visibility="{Binding ShowDailySalesFilters, Converter={StaticResource BoolToVis}}"
                        Background="#F8FAFC" CornerRadius="10" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="محددات تقرير النشاط اليومي والمبيعات"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Branches multi-select -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الفرع / الفروع المستهدفة (اختر واحداً أو أكثر)"
                                           Style="{StaticResource SectionLabel}"/>
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                        CornerRadius="6" Padding="12" MinHeight="80" MaxHeight="160">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CheckableBranches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              FontFamily="Segoe UI, Tahoma"
                                                              FontSize="13" Margin="0,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="(اتركها فارغة لعرض جميع الفروع)"
                                           FontSize="10" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Right: Date filter -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تصفية حسب التاريخ"
                                           Style="{StaticResource SectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Content="سنة معينة" GroupName="DateMode1"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Year, Mode=TwoWay}"/>
                                    <RadioButton Content="شهر معين" GroupName="DateMode1"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Month, Mode=TwoWay}"/>
                                    <RadioButton Content="يوم محدد" GroupName="DateMode1"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=SpecificDay, Mode=TwoWay}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding IsYearFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="السنة:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding SelectedYear}" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMonthFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الشهر:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}"
                                              SelectedItem="{Binding SelectedMonth}" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDayFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التاريخ:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="160"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PrintBtn}"
                                Command="{Binding PrintReportCommand}"
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ 2: INVOICES FILTERS ══════════════════ -->
                <Border Visibility="{Binding ShowInvoicesFilters, Converter={StaticResource BoolToVis}}"
                        Background="#F8FAFC" CornerRadius="10" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="محددات تقرير الفواتير المستلمة"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="كل الخيارات اختيارية — يمكنك اختيار واحد أو أكثر أو الكل"
                                   FontSize="11" Foreground="#6B7280" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Branches -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الفروع المستلمة" Style="{StaticResource SectionLabel}"/>
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                        CornerRadius="6" Padding="12" MinHeight="80" MaxHeight="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CheckableBranches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              FontFamily="Segoe UI, Tahoma"
                                                              FontSize="13" Margin="0,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="(الكل إذا لم يُحدد)"
                                           FontSize="10" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Trader -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="التاجر المورّد (اختياري)" Style="{StaticResource SectionLabel}"/>
                                <ComboBox ItemsSource="{Binding Traders}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedTrader}"/>
                                <TextBlock Text="(الكل إذا لم يُحدد)"
                                           FontSize="10" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Date -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="تصفية حسب التاريخ" Style="{StaticResource SectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Content="سنة" GroupName="DateMode2"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Year, Mode=TwoWay}"/>
                                    <RadioButton Content="شهر" GroupName="DateMode2"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Month, Mode=TwoWay}"/>
                                    <RadioButton Content="يوم" GroupName="DateMode2"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=SpecificDay, Mode=TwoWay}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding IsYearFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="السنة:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="50"/>
                                    <ComboBox ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding SelectedYear}" Width="110"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMonthFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الشهر:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="50"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}"
                                              SelectedItem="{Binding SelectedMonth}" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDayFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التاريخ:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="50"/>
                                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="150"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PrintBtn}"
                                Command="{Binding PrintReportCommand}"
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ 3: TRADER FILTERS ═════════════════════ -->
                <Border Visibility="{Binding ShowTraderFilters, Converter={StaticResource BoolToVis}}"
                        Background="#F8FAFC" CornerRadius="10" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="كشف حساب تفصيلي للتاجر"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اختر التاجر *" Style="{StaticResource SectionLabel}"/>
                                <ComboBox ItemsSource="{Binding Traders}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedTrader}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تصفية حسب التاريخ" Style="{StaticResource SectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Content="كل الفترة" GroupName="DateMode3"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=All, Mode=TwoWay}"/>
                                    <RadioButton Content="سنة" GroupName="DateMode3"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Year, Mode=TwoWay}"/>
                                    <RadioButton Content="شهر" GroupName="DateMode3"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Month, Mode=TwoWay}"/>
                                    <RadioButton Content="يوم محدد" GroupName="DateMode3"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=SpecificDay, Mode=TwoWay}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding IsYearFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="السنة:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding SelectedYear}" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMonthFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الشهر:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}"
                                              SelectedItem="{Binding SelectedMonth}" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDayFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التاريخ:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="160"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PrintBtn}"
                                Command="{Binding PrintReportCommand}"
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ 4: EMPLOYEE FILTERS ══════════════════ -->
                <Border Visibility="{Binding ShowEmployeeFilters, Converter={StaticResource BoolToVis}}"
                        Background="#F8FAFC" CornerRadius="10" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="كشف حساب تفصيلي للموظف"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اختر الموظف *" Style="{StaticResource SectionLabel}"/>
                                <ComboBox ItemsSource="{Binding Employees}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedEmployee}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تصفية حسب التاريخ" Style="{StaticResource SectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Content="كل الفترة" GroupName="DateMode4"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=All, Mode=TwoWay}"/>
                                    <RadioButton Content="سنة" GroupName="DateMode4"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Year, Mode=TwoWay}"/>
                                    <RadioButton Content="شهر" GroupName="DateMode4"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Month, Mode=TwoWay}"/>
                                    <RadioButton Content="يوم محدد" GroupName="DateMode4"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=SpecificDay, Mode=TwoWay}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding IsYearFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="السنة:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding SelectedYear}" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMonthFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الشهر:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}"
                                              SelectedItem="{Binding SelectedMonth}" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDayFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التاريخ:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="160"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PrintBtn}"
                                Command="{Binding PrintReportCommand}"
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ 5: BRANCH FILTERS ════════════════════ -->
                <Border Visibility="{Binding ShowBranchFilters, Converter={StaticResource BoolToVis}}"
                        Background="#F8FAFC" CornerRadius="10" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="كشف حساب تفصيلي للفرع"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اختر الفرع *" Style="{StaticResource SectionLabel}"/>
                                <ComboBox ItemsSource="{Binding Branches}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedBranch}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تصفية حسب التاريخ" Style="{StaticResource SectionLabel}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Content="كل الفترة" GroupName="DateMode5"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=All, Mode=TwoWay}"/>
                                    <RadioButton Content="سنة" GroupName="DateMode5"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Year, Mode=TwoWay}"/>
                                    <RadioButton Content="شهر" GroupName="DateMode5"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=Month, Mode=TwoWay}"/>
                                    <RadioButton Content="يوم محدد" GroupName="DateMode5"
                                                 Style="{StaticResource FilterRadio}"
                                                 IsChecked="{Binding DateFilterMode,
                                                     Converter={StaticResource StringToBoolConverter},
                                                     ConverterParameter=SpecificDay, Mode=TwoWay}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding IsYearFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="السنة:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding SelectedYear}" Width="120"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMonthFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الشهر:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <ComboBox ItemsSource="{Binding AvailableMonths}"
                                              SelectedItem="{Binding SelectedMonth}" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDayFilterVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التاريخ:" VerticalAlignment="Center"
                                               Foreground="#374151" Width="55"/>
                                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="160"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PrintBtn}"
                                Command="{Binding PrintReportCommand}"
                                HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bottom padding -->
                <Border Height="10"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════ STATUS BAR ═══════════════════════════ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563" FontSize="13"/>
        </Border>

    </Grid>
</UserControl>
