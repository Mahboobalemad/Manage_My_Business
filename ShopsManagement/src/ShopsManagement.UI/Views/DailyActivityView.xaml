<UserControl x:Class="ShopsManagement.UI.Views.DailyActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Branch/Year Selector & Add Button -->
            <RowDefinition Height="Auto"/> <!-- Month Tabs Header -->
            <RowDefinition Height="Auto"/> <!-- Monthly Summary Cards (4 Cards) -->
            <RowDefinition Height="*"/>    <!-- Data Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 سجل المبيعات والنشاط اليومي" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="— إدخال ومتابعة المبيعات والمصروفات والأرباح" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Branch Filter, Year Filter & Add Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المحل / الفرع:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBranch}" 
                              Width="180" Padding="6,4" Margin="0,0,15,0"/>

                    <TextBlock Text="السنة:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" 
                              Width="90" Padding="6,4" Margin="0,0,15,0"/>

                    <Button Content="+ إضافة مبيعات يومية" Command="{Binding OpenAddDialogCommand}" 
                            Background="#10B981" Foreground="White" Padding="14,8" BorderThickness="0" FontWeight="Bold" FontSize="13">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Month Tabs -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="5" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding MonthTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding MonthName}" 
                                     IsChecked="{Binding IsSelected}" 
                                     Command="{Binding DataContext.SelectMonthTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}"
                                     Height="38" Margin="2" Padding="0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     FontSize="13" FontWeight="SemiBold">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Monthly Summary Cards (4 Cards: Total Sales, Total Expenses, Net Sales, Total Profits) -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Sales Card -->
            <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المبيعات" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MonthlyTotalSales, StringFormat={}{0:N2} ر.ي}" Foreground="#065F46" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Expenses Card -->
            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المصروفات" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MonthlyTotalExpenses, StringFormat={}{0:N2} ر.ي}" Foreground="#991B1B" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Net Sales Card -->
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="صافي المبيعات" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MonthlyNetSales, StringFormat={}{0:N2} ر.ي}" Foreground="#1E40AF" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Profits Card -->
            <Border Grid.Column="3" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="إجمالي الأرباح" Foreground="#6D28D9" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MonthlyTotalProfits, StringFormat={}{0:N2} ر.ي}" Foreground="#5B21B6" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Daily Activities DataGrid -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Activities}" 
                      SelectedItem="{Binding SelectedActivity}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="40"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <!-- Date -->
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="110"/>
                    
                    <!-- Branch Name -->
                    <DataGridTextColumn Header="المحل / الفرع" Binding="{Binding Branch.Name}" Width="140"/>

                    <!-- Total Sales -->
                    <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat={}{0:N2} ر.ي}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Expenses -->
                    <DataGridTextColumn Header="إجمالي المصروفات" Binding="{Binding TotalExpenses, StringFormat={}{0:N2} ر.ي}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Net Sales -->
                    <DataGridTextColumn Header="صافي المبيعات" Binding="{Binding NetSales, StringFormat={}{0:N2} ر.ي}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Profits -->
                    <DataGridTextColumn Header="الأرباح" Binding="{Binding DisplayProfit, StringFormat={}{0:N2} ر.ي}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#5B21B6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Notes -->
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Actions (Edit & Delete buttons) -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="تعديل" 
                                            Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Background="#3B82F6" Foreground="White" Padding="10,4" Margin="0,0,6,0" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="حذف" 
                                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Background="#EF4444" Foreground="White" Padding="10,4" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Footer -->
        <Border Grid.Row="4" Background="#F8FAFC" Padding="10" Margin="0,15,0,0" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334155" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
