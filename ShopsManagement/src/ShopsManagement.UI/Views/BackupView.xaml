<UserControl x:Class="ShopsManagement.UI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignHeight="700" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Action button base style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global fonts and DataGrid headers -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily"   Value="Segoe UI, Tahoma"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Background"   Value="#F1F5F9"/>
            <Setter Property="Foreground"   Value="#374151"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="BorderBrush"  Value="#E2E8F0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Info bar -->
            <RowDefinition Height="Auto"/>  <!-- Actions -->
            <RowDefinition Height="*"/>     <!-- Logs grid -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💾" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="النسخ الاحتياطي واستعادة البيانات"
                               Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="حافظ على أمان بياناتك — نسخ يدوي وتلقائي ورفع على السحابة"
                               Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ AUTO-BACKUP INFO BAR ════════════════════════════════ -->
        <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD"
                BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏰ " Foreground="#0369A1" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="جدول النسخ التلقائي الحالي: " Foreground="#0369A1" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackupFrequencyLabel}" Foreground="#0369A1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="آخر نسخة تلقائية: " Foreground="#0369A1" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastAutoBackupDateText}" Foreground="#0369A1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="يمكن تغيير جدول النسخ من قسم الإعدادات"
                           Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ACTIONS BAR ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Main action buttons -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Create manual backup -->
                    <Button Content="➕  إنشاء نسخة احتياطية الآن"
                            Command="{Binding CreateManualBackupCommand}"
                            Background="#2563EB" Style="{StaticResource ActionBtn}"
                            Margin="0,0,10,0"/>

                    <!-- Google Drive upload -->
                    <Button Content="☁️  رفع على Google Drive"
                            Command="{Binding UploadToGoogleDriveCommand}"
                            Background="#EA4335" Style="{StaticResource ActionBtn}"
                            Margin="0,0,10,0"/>

                    <!-- Restore -->
                    <Button Content="📂  استعادة نسخة سابقة"
                            Command="{Binding RestoreBackupCommand}"
                            Background="#D97706" Style="{StaticResource ActionBtn}"
                            Margin="0,0,0,0"/>
                </WrapPanel>

                <!-- Right: Refresh -->
                <Button Grid.Column="1" Content="🔄 تحديث السجل"
                        Command="{Binding RefreshLogsCommand}"
                        Background="#475569" Style="{StaticResource ActionBtn}"/>
            </Grid>
        </Border>

        <!-- ══ BACKUP LOGS ══════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" Margin="0,0,0,0">
            <DockPanel Margin="20,14">
                <TextBlock DockPanel.Dock="Top" Text="سجل عمليات النسخ الاحتياطي"
                           FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                <DataGrid ItemsSource="{Binding BackupLogs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="40"
                          Background="Transparent"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="التاريخ والوقت"
                                            Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                            Width="155"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}"    Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="100"/>
                        <DataGridTextColumn Header="مسار / معرف الملف"
                                            Binding="{Binding FilePathOrDriveFileId}"  Width="*"/>
                        <DataGridTextColumn Header="ملاحظات"
                                            Binding="{Binding Notes}"                  Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ══ STATUS BAR ══════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
