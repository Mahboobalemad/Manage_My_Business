<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddZakatEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة بند زكاة" Height="460" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Text="💰 إضافة بند زكاة منفقة جديد"
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <!-- Date -->
                <TextBlock Text="التاريخ *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpDate" Padding="6" FontSize="14" Margin="0,0,0,12"/>

                <!-- Zakat Amount (Optional / Can be 0) -->
                <TextBlock Text="مبلغ الزكاة (اختياري - يمكن أن يكون صفر)" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAmount" Text="0" Padding="8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Zakat Type (Custom input by Admin) -->
                <TextBlock Text="نوع الزكاة (يسجلها الأدمن حسب رغبته) *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbZakatType" IsEditable="True" Padding="6" FontSize="14" Margin="0,0,0,12">
                    <ComboBoxItem Content="زكاة مال"/>
                    <ComboBoxItem Content="زكاة عروش وتجارة"/>
                    <ComboBoxItem Content="زكاة فطر"/>
                    <ComboBoxItem Content="صدقات عامة ومساعدات"/>
                    <ComboBoxItem Content="مستحقات أيتام ومساكين"/>
                </ComboBox>

                <!-- Notes -->
                <TextBlock Text="ملاحظات (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnSave" Content="إضافة" Click="BtnSave_Click"
                    Background="#2563EB" Foreground="White" Padding="25,10" Margin="0,0,10,0"
                    BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            <Button Content="إلغاء" Click="BtnCancel_Click"
                    Background="#64748B" Foreground="White" Padding="15,10"
                    BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
