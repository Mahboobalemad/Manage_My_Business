<Window x:Class="ShopsManagement.UI.Views.Dialogs.BranchDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الفرع" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header with branch info -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar -->
            <RowDefinition Height="Auto"/>  <!-- Summary cards (for Sales view) -->
            <RowDefinition Height="*"/>     <!-- Data table -->
            <RowDefinition Height="Auto"/>  <!-- Close button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtBranchTitle" Text="🏪 تفاصيل الفرع"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtBranchSubtitle" Text=""
                               Foreground="#94A3B8" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="TxtBranchStatus" Text="نشط"
                               Foreground="#10B981" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <!-- Filter 1: Category -->
                <TextBlock Text="عرض:" Foreground="#475569" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbCategory" Width="200" Padding="6,4" Margin="0,0,20,0"
                          SelectionChanged="CmbCategory_SelectionChanged">
                    <ComboBoxItem Content="المبيعات والمصروفات" Tag="Sales" IsSelected="True"/>
                    <ComboBoxItem Content="الفواتير (البضاعة المستلمة)" Tag="Invoices"/>
                    <ComboBoxItem Content="العمال والموظفون" Tag="Employees"/>
                </ComboBox>

                <!-- Filter 2: Year -->
                <TextBlock Text="السنة:" Foreground="#475569" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbYear" Width="120" Padding="6,4" Margin="0,0,20,0"
                          SelectionChanged="CmbYear_SelectionChanged"/>

                <!-- Filter 3: Month -->
                <TextBlock x:Name="TxtMonthLabel" Text="الشهر:" Foreground="#475569" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbMonth" Width="140" Padding="6,4"
                          SelectionChanged="CmbMonth_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Sales Summary Cards (shown only when Sales category selected) -->
        <Grid x:Name="GridSalesSummary" Grid.Row="2" Margin="0,0,0,12" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المبيعات" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalSales" Text="0.00 ر.ي"
                               Foreground="#065F46" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المصروفات" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalExpenses" Text="0.00 ر.ي"
                               Foreground="#991B1B" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="صافي المبيعات" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtNetSales" Text="0.00 ر.ي"
                               Foreground="#1E40AF" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="صافي الأرباح" Foreground="#6D28D9" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtNetProfits" Text="0.00 ر.ي"
                               Foreground="#5B21B6" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Invoice Total Summary -->
        <Border x:Name="BorderInvoiceTotal" Grid.Row="2" Background="#FFFBEB" BorderBrush="#FDE68A"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="إجمالي الفواتير في الفترة المحددة: " Foreground="#92400E" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="TxtTotalInvoices" Text="0.00 ر.ي" Foreground="#92400E" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Data Grid area -->
        <Border x:Name="BorderSalesGrid" Grid.Row="3" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Visible">
            <!-- SALES DataGrid -->
            <DataGrid x:Name="GridSales" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" RowHeight="38"
                      Background="Transparent" BorderThickness="0" Visibility="Visible">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="120"/>
                    <DataGridTextColumn Header="إجمالي المبيعات (ر.ي)" Binding="{Binding TotalSales, StringFormat={}{0:N2}}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="إجمالي المصروفات (ر.ي)" Binding="{Binding TotalExpenses, StringFormat={}{0:N2}}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="صافي المبيعات (ر.ي)" Binding="{Binding NetSales, StringFormat={}{0:N2}}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الأرباح (ر.ي)" Binding="{Binding DisplayProfit, StringFormat={}{0:N2}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#5B21B6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Hidden Invoice DataGrid (will be swapped in code) -->
        <Border x:Name="BorderInvoicesGrid" Grid.Row="3" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
            <DataGrid x:Name="GridInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" RowHeight="38"
                      Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="120"/>
                    <DataGridTextColumn Header="إجمالي الفاتورة (ر.ي)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#92400E"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="اسم الفاتورة" Binding="{Binding InvoiceName}" Width="*"/>
                    <DataGridTextColumn Header="اسم التاجر" Binding="{Binding Trader.Name}" Width="160"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Hidden Employees Grid -->
        <Border x:Name="BorderEmployeesGrid" Grid.Row="3" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
            <DataGrid x:Name="GridEmployees" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" RowHeight="38"
                      Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="إجمالي الرصيد له (ر.ي)" Binding="{Binding TotalEntitlements, StringFormat={}{0:N2}}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="إجمالي الرصيد عليه (ر.ي)" Binding="{Binding TotalWithdrawalsAndDeductions, StringFormat={}{0:N2}}" Width="190">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="المتبقي له / عليه" Binding="{Binding NetEntitlementDisplayText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Close Button -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <Button Content="إغلاق" Click="BtnClose_Click"
                    Background="#64748B" Foreground="White" Padding="20,10"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"
                    HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</Window>
