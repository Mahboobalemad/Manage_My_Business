<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddTraderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة تاجر جديد" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Text="🤝 إضافة تاجر / مورد جديد"
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <!-- Trader Name -->
                <TextBlock Text="اسم التاجر *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <!-- Location -->
                <TextBlock Text="الموقع / العنوان" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLocation" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <!-- Business Name -->
                <TextBlock Text="اسم النشاط التجاري (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtBusinessName" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <!-- Phone -->
                <TextBlock Text="رقم الهاتف (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPhone" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <!-- Opening Balance -->
                <TextBlock Text="الرصيد الافتتاحي (ر.ي) (اختياري)" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="ملاحظة: ادخل قيمة موجب (+) إذا كان للتاجر مستحقات عليك، أو قيمة سالبة (-) إذا كان عليك دائنية للتاجر"
                           Foreground="#64748B" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox x:Name="TxtOpeningBalance" Text="0" Padding="8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="ChkIsActive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="التاجر نشط" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Notes -->
                <TextBlock Text="ملاحظات (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnSave" Content="إضافة إلى القائمة" Click="BtnSave_Click"
                    Background="#2563EB" Foreground="White" Padding="20,10" Margin="0,0,10,0"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"/>
            <Button Content="إلغاء" Click="BtnCancel_Click"
                    Background="#64748B" Foreground="White" Padding="15,10"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
