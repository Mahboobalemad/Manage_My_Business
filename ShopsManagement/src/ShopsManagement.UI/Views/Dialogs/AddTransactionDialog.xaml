<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة حركة مالية جديدة للموظف" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="💳 تسجيل حركة مالية للموظف" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form Controls -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="التاريخ *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Padding="6" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="نوع الحركة *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbType" Padding="6" FontSize="13"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="المبلغ (ر.ي) *" Foreground="#047857" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAmount" Padding="8" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="البيان / ملاحظات" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNotes" Padding="8" Height="65" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إضافة إلى القائمة" Click="BtnSave_Click" Background="#059669" Foreground="White" Padding="20,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" FontSize="14"/>
            <Button Content="إلغاء" Click="BtnCancel_Click" Background="#64748B" Foreground="White" Padding="15,10" BorderThickness="0" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
