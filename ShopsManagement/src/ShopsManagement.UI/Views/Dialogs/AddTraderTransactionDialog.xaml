<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddTraderTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة حركة للتاجر" Height="440" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Text="📝 إضافة حركة حساب للتاجر"
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <!-- Date -->
                <TextBlock Text="التاريخ *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpDate" Padding="6" FontSize="14" Margin="0,0,0,12"/>

                <!-- Transaction Type -->
                <TextBlock Text="نوع الحركة *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbType" Padding="8" FontSize="14" Margin="0,0,0,12">
                    <ComboBoxItem Content="بضاعة مستلمة (فاتورة)" Tag="Invoice" IsSelected="True"/>
                    <ComboBoxItem Content="دفعة من الحساب (تسديد)" Tag="Payment"/>
                </ComboBox>

                <!-- Amount -->
                <TextBlock Text="المبلغ (ر.ي) *" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAmount" Padding="8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Notes -->
                <TextBlock Text="ملاحظات (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnSave" Content="إضافة إلى القائمة" Click="BtnSave_Click"
                    Background="#2563EB" Foreground="White" Padding="20,10" Margin="0,0,10,0"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"/>
            <Button Content="إلغاء" Click="BtnCancel_Click"
                    Background="#64748B" Foreground="White" Padding="15,10"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
