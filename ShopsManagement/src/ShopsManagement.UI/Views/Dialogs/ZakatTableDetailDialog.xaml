<Window x:Class="ShopsManagement.UI.Views.Dialogs.ZakatTableDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الزكاة المنفقة" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Action Bar -->
            <RowDefinition Height="*"/>     <!-- Entries DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTableTitle" Text="🌙 تفاصيل الزكاة المنفقة"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTableSubtitle" Text=""
                               Foreground="#94A3B8" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalSpent" Text="0.00 ر.ي"
                               Foreground="#10B981" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="سجل بنود الزكاة والصدقات المنفقة:"
                           Foreground="#475569" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                <!-- Add Entry Button -->
                <Button Grid.Column="1" Content="+ إضافة الزكاة" Click="BtnAddEntry_Click"
                        Background="#2563EB" Foreground="White" Padding="16,8"
                        BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Entries DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="DgEntries"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="40"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="مبلغ الزكاة (ر.ي)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#059669"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="نوع الزكاة" Binding="{Binding ZakatType}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="إجراءات" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="✏️ تعديل" Click="BtnEditEntry_Click" CommandParameter="{Binding}"
                                            Background="#0EA5E9" Foreground="White" Padding="6,3" Margin="0,0,4,0"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="🗑️ حذف" Click="BtnDeleteEntry_Click" CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" Padding="6,3"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Close Button -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Button Content="إغلاق" Click="BtnClose_Click"
                    Background="#64748B" Foreground="White" Padding="20,10"
                    BorderThickness="0" FontWeight="Bold" FontSize="14"
                    HorizontalAlignment="Left" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
