<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddEmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة موظف جديد" Height="480" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="👤 إضافة موظف جديد إلى السجل" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Form Controls -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="اسم الموظف *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8" FontSize="14" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="تاريخ الدخول (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpHireDate" Padding="6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="الراتب الشهري (اختياري)" Foreground="#047857" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSalary" Text="0" Padding="8" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="الرصيد الافتتاحي له / عليه (ر.ي)" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="ملاحظة: ادخل قيمة موجبة (+500) إذا كان له مستحقات، أو قيمة سالبة (-200) إذا كان عليه ديون" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOpeningBalance" Text="0" Padding="8" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="المسمى الوظيفي" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPosition" Padding="8" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="الفرع *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBranch" DisplayMemberPath="Name" Padding="8" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ملاحظات" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إضافة إلى القائمة" Click="BtnSave_Click" Background="#2563EB" Foreground="White" Padding="20,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" FontSize="14"/>
            <Button Content="إلغاء" Click="BtnCancel_Click" Background="#64748B" Foreground="White" Padding="15,10" BorderThickness="0" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
