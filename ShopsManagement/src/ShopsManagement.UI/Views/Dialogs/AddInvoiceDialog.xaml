<Window x:Class="ShopsManagement.UI.Views.Dialogs.AddInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة فاتورة بضاعة" Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Form & Allocations DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Total & Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Text="📦 تسجيل فاتورة بضاعة جديدة"
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <!-- Row 1: Date & Invoice Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تاريخ الفاتورة *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDate" Padding="6" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="رقم / اسم الفاتورة *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInvoiceName" Padding="7" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Trader Selection -->
                <TextBlock Text="التاجر المورّد *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTrader" DisplayMemberPath="Name" Padding="8" FontSize="14" Margin="0,0,0,15"/>

                <!-- Branches & Allocations Section -->
                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🏬 الفروع المستلمة وتوزيع المبلغ:"
                                   Foreground="#1E293B" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="اختر فرعاً أو أكثر وأدخل المبلغ المخصص لكل فرع مستلم:"
                                   Foreground="#64748B" FontSize="12" Margin="0,0,0,8"/>

                        <!-- DataGrid for Branch Allocation -->
                        <DataGrid x:Name="DgBranchAllocations"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="38"
                                  Height="160"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <!-- CheckBox -->
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <!-- Branch Name -->
                                <DataGridTextColumn Header="اسم الفرع" Binding="{Binding BranchName}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Allocated Amount -->
                                <DataGridTemplateColumn Header="المبلغ المخصص (ر.ي)" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4" FontSize="13" FontWeight="Bold"
                                                     IsEnabled="{Binding IsSelected}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <TextBlock Text="ملاحظات (اختياري)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Padding="8" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Total & Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Total Amount Card -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="إجمالي الفاتورة الكلي: " Foreground="#1E293B" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtTotalAmount" Text="0.00 ر.ي" Foreground="#2563EB" FontSize="18" FontWeight="Bold" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSave" Content="حفظ الفاتورة" Click="BtnSave_Click"
                        Background="#2563EB" Foreground="White" Padding="20,10" Margin="0,0,10,0"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="إلغاء" Click="BtnCancel_Click"
                        Background="#64748B" Foreground="White" Padding="15,10"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
