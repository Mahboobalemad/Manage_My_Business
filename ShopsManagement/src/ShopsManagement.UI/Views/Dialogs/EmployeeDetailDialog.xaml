<Window x:Class="ShopsManagement.UI.Views.Dialogs.EmployeeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ShopsManagement.UI.Converters"
        Title="تفاصيل كشف حساب الموظف" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:NetBalanceColorConverter x:Key="NetBalanceColorConverter"/>
        <converters:NetBalanceTextConverter x:Key="NetBalanceTextConverter"/>
        <converters:EmployeeTransactionTypeNameConverter x:Key="EmployeeTransactionTypeNameConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Employee Info & Summary Card -->
            <RowDefinition Height="Auto"/> <!-- Filters & Action Bar -->
            <RowDefinition Height="*"/>    <!-- Transactions DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer Status -->
        </Grid.RowDefinitions>

        <!-- Employee Info & Summary Card -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtEmployeeName" Text="اسم الموظف" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPosition" Text=" (المسمى الوظيفي)" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubInfo" Text="الفرع | الراتب الشهري" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Net Entitlement Card -->
                <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="صافي المستحق الحقيقي" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNetBalance" Text="0.00 ر.ي" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filters & Add Transaction Action Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Add Transaction Button -->
                <Button Grid.Column="0" Content="➕ إضافة حركة مالية" Click="BtnAddTransaction_Click" 
                        Background="#2563EB" Foreground="White" Padding="14,6" BorderThickness="0" FontWeight="Bold" FontSize="13"/>

                <!-- Filters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="السنة:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                    <ComboBox x:Name="CmbFilterYear" SelectionChanged="Filter_Changed" Width="95" Padding="5,3" Margin="0,0,10,0"/>

                    <TextBlock Text="الشهر:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                    <ComboBox x:Name="CmbFilterMonth" SelectionChanged="Filter_Changed" Width="85" Padding="5,3" Margin="0,0,10,0"/>

                    <TextBlock Text="نوع الحركة:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                    <ComboBox x:Name="CmbFilterType" SelectionChanged="Filter_Changed" Width="130" Padding="5,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transactions DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="DgTransactions" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="36"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="110"/>
                    
                    <!-- Arabic Transaction Type Converter -->
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type, Converter={StaticResource EmployeeTransactionTypeNameConverter}}" Width="130"/>

                    <DataGridTextColumn Header="المبلغ (ر.ي)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="ملاحظات والبيان" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTemplateColumn Header="إجراءات" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="تعديل" Click="BtnEditTx_Click" CommandParameter="{Binding}" Background="#64748B" Foreground="White" Padding="6,2" Margin="2" FontSize="11" BorderThickness="0"/>
                                    <Button Content="حذف" Click="BtnDeleteTx_Click" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Padding="6,2" Margin="2" FontSize="11" BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#F8FAFC" Padding="8" Margin="0,10,0,0" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="جاهز" Foreground="#334155" FontSize="12"/>
        </Border>
    </Grid>
</Window>
