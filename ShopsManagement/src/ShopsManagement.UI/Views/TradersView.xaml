<UserControl x:Class="ShopsManagement.UI.Views.TradersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Action & Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Main Traders DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- Header and Overall KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤝" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="إدارة حسابات التجار والموردين" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="— متابعة الفواتير والدفعات والمستحقات المتبقية" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3 Global Summary Cards -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Invoices Card -->
                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الفواتير الكلي (دائن +)" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverallSummary.OverallTotalInvoices, StringFormat={}{0:N2} ر.ي}" Foreground="#1E40AF" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Payments Card -->
                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الدفعات المسددة الكلي (مدين -)" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverallSummary.OverallTotalPayments, StringFormat={}{0:N2} ر.ي}" Foreground="#065F46" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Net Outstanding Balance Card -->
                <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="إجمالي الرصيد المستحق للتجار" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverallSummary.OverallOutstandingBalance, StringFormat={}{0:N2} ر.ي}" Foreground="#991B1B" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Filter & Action Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="حالة التجار:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="160" Padding="6,4"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}">
                        <ComboBoxItem Content="جميع التجار" IsSelected="True"/>
                        <ComboBoxItem Content="التجار النشطون فقط"/>
                        <ComboBoxItem Content="التجار غير النشطين فقط"/>
                    </ComboBox>
                </StackPanel>

                <!-- Add Trader Button -->
                <Button Grid.Column="1" Content="+ إضافة تاجر جديد"
                        Command="{Binding OpenAddTraderDialogCommand}"
                        Background="#2563EB" Foreground="White"
                        Padding="18,10" BorderThickness="0"
                        FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Traders DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding TradersSummaries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="45"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Trader Name - Clickable -->
                    <DataGridTemplateColumn Header="اسم التاجر" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Command="{Binding DataContext.OpenTraderDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               TextDecorations="None">
                                        <TextBlock Text="{Binding TraderName}" Foreground="#2563EB" FontWeight="Bold" FontSize="14"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="النشاط التجاري" Binding="{Binding BusinessName}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Invoices (له) -->
                    <DataGridTextColumn Header="إجمالي الفواتير (له)" Binding="{Binding TotalInvoices, StringFormat={}{0:N2} ر.ي}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Payments (عليه) -->
                    <DataGridTextColumn Header="إجمالي الدفعات (عليه)" Binding="{Binding TotalPayments, StringFormat={}{0:N2} ر.ي}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Net Balance (Dynamic Colors) -->
                    <DataGridTemplateColumn Header="المتبقي له / عليه" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegativeNet}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding NetBalanceDisplayText, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="الحالة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="إجراءات" Width="155">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="✏️ تعديل"
                                            Command="{Binding DataContext.OpenEditTraderDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="#0EA5E9" Foreground="White"
                                            Padding="8,4" Margin="0,0,4,0" BorderThickness="0"
                                            FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="🗑️ حذف"
                                            Command="{Binding DataContext.DeleteTraderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White"
                                            Padding="8,4" BorderThickness="0"
                                            FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#F8FAFC" Padding="10" Margin="0,12,0,0" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#334155" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
